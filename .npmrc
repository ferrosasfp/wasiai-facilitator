# Supply-chain hardening: never run package lifecycle scripts (postinstall, etc.)
# on `npm install`. A malicious or compromised transitive dependency cannot
# execute arbitrary code at install time. The facilitator holds the operator
# signing key, so install-time RCE is a high-impact threat we close here.
#
# If a legitimate dependency genuinely needs its install script, run it
# explicitly and scoped (e.g. `npm rebuild <pkg>`), never globally re-enabled.
ignore-scripts=true
