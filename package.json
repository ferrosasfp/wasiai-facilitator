{
  "name": "wasiai-facilitator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-grade self-hosted x402 facilitator for EVM chains (Kite, Avalanche, extensible). Part of WasiAI ecosystem.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "security:audit": "npm audit --audit-level=high",
    "qa": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@supabase/supabase-js": "^2.104.1",
    "bullmq": "^5.28.0",
    "fastify": "^5.8.4",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "viem": "^2.47.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-no-secrets": "^2.1.1",
    "eslint-plugin-security": "^3.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ferrosasfp/wasiai-facilitator.git"
  },
  "keywords": [
    "x402",
    "facilitator",
    "eip-3009",
    "kite",
    "evm",
    "payment",
    "blockchain",
    "stablecoin",
    "wasiai"
  ],
  "author": "Fernando Rosas (OpenClaw)",
  "license": "MIT"
}
